STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-v2

# ── Object storage S3-compatibil (Hetzner) ──
# Gol = fișierele se scriu local în ./static (doar dev).
# Cheile reale stau în backend/.env (gitignored), NU aici — fișierul e în git.
S3_BUCKET=
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=hel1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL-ul public al bucket-ului, fără slash la final:
S3_FILE_URL=https://hel1.your-objectstorage.com/<bucket>

# ── ERP (aplicația de gestiune Laravel) ──
# Comenzile plecă spre ERP la fiecare eveniment relevant (plasare, plată,
# livrare, anulare, retur). Fără ambele valori, subscriberul `erp-order-sync`
# se autodezactivează și stocul NU se scade în gestiune.
# ERP_WEBHOOK_SECRET trebuie să fie EXACT aceeași valoare ca MEDUSA_WEBHOOK_SECRET
# din .env-ul Laravel.
ERP_WEBHOOK_URL=
ERP_WEBHOOK_SECRET=
# Opțional: locația de stoc pe care scrie ERP-ul (implicit prima din Medusa).
ERP_STOCK_LOCATION_ID=

# ── Cont bancar pentru comenzile pe ordin de plată ──
# Apare în emailul de virament („În așteptarea viramentului" din admin).
# Fără BANK_IBAN, ruta de status refuză să trimită emailul — nu completa cu
# valori aproximative, banii ar pleca în alt cont.
BANK_IBAN=
BANK_NAME=
# Beneficiarul; implicit denumirea societății.
BANK_HOLDER=
